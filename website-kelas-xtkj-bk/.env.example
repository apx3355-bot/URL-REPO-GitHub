# ===== DATABASE (PostgreSQL — Supabase) =====
# DATABASE_URL: koneksi POOLED (PgBouncer) untuk runtime aplikasi — port 6543.
# Format Supabase pooler:
#   postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL=""

# DIRECT_URL: koneksi LANGSUNG untuk prisma migrate / db push — port 5432.
# Format:
#   postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=""

# ===== SESSION =====
# Secret signing session — WAJIB, min 32 karakter acak
# (openssl rand -base64 48)
SESSION_SECRET=""

# ===== SEED =====
# Password akun seed — WAJIB saat menjalankan npm run db:seed.
# Seed berhenti dengan error jika variabel ini kosong (tanpa fallback hardcoded).
SEED_DEVELOPER_PASSWORD=""
SEED_WALI_KELAS_PASSWORD=""
SEED_ANGGOTA_PASSWORD=""
